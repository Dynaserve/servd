# Servd configuration. install.sh copies this to /etc/servd/servd.env and fills
# in the secrets on first install; edit that file, then: systemctl restart servd

# Address of the API the dashboard talks to.
LISTEN_ADDR=:8080
# Hostname or IP put in app URLs (http://PUBLIC_HOST:9000 …). Use your
# server's public IP or domain.
PUBLIC_HOST=__PUBLIC_HOST__
REGION=AU

# Build and run apps with the built-in engine (no Docker).
RUNTIME=native
# Docker Hub limits anonymous pulls; this mirror avoids that.
REGISTRY_MIRROR=mirror.gcr.io

# Where services are saved. Set DATABASE_URL to use PostgreSQL instead.
DATA_FILE=/var/lib/servd/store.json
#DATABASE_URL=postgres://servd:password@localhost:5432/servd

# Must be the same value as the dashboard's SESSION_SECRET.
SESSION_SECRET=__SESSION_SECRET__
# Exactly 32 characters; encrypts stored GitHub tokens.
ENCRYPTION_KEY=__ENCRYPTION_KEY__

# Optional GitHub App for private repos (see README).
#GITHUB_APP_ID=
#GITHUB_APP_PRIVATE_KEY_PATH=/etc/servd/github-app.pem
